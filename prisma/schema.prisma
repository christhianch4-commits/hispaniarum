// Esquema de datos de INGENIUACADEMY.
// Postgres (Neon, vía Vercel Storage). DATABASE_URL es la conexión pooled
// (runtime); DATABASE_URL_UNPOOLED es la conexión directa que usa
// `prisma db push`/migrate para DDL (recomendado por Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  COMPANY_ADMIN
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  enrollments  Enrollment[]
  certificates CertificateIssuance[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug  String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, courseSlug])
}

model CertificateIssuance {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug String
  certType   String
  issuedAt   DateTime @default(now())
}

// Catálogo editable desde /admin/cursos. Categorías e instructores siguen
// siendo datos de referencia estáticos (app/data/) por ahora.
model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  description      String
  categorySlug     String
  instructorSlug   String
  level            String // "Principiante" | "Intermedio" | "Avanzado" | "Todos los niveles"
  price            Float
  oldPrice         Float?
  rating           Float    @default(4.8)
  reviewsCount     Int      @default(0)
  studentsCount    Int      @default(0)
  durationHours    Int
  color            String   @default("#2F81F7")
  certType         String   @default("empresarial") // "mdt" | "empresarial" | "ambos"
  featured         Boolean  @default(false)
  whatYouWillLearn String // JSON string[]
  requirements     String // JSON string[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // --- Canal de entrega y venta ---
  channel         String  @default("propio") // "hotmart" | "propio" | "regulado"
  published       Boolean @default(true) // false = borrador (no aparece en el sitio)
  sample          Boolean @default(false) // curso de ejemplo de la demo (se muestra con etiqueta y se oculta en bloque)
  isFree          Boolean @default(false) // clase gratuita (captura de leads)
  checkoutUrl     String? // Hotmart: checkout individual
  teamCheckoutUrl String? // Hotmart: checkout plan equipos
  teamSeats       Int? // cupos del plan equipos
  teamPrice       Float? // precio total del plan equipos
  productUrl      String? // ficha del producto en Hotmart
  freeAccessUrl   String? // clase gratuita: enlace de acceso tras dejar el correo
  freeClassSlug   String? // curso de pago -> slug de su clase gratuita
  guaranteeDays   Int?
  lessonsCount    Int     @default(0) // total declarado cuando no se detallan lecciones
  audience        String  @default("[]") // JSON string[]  (para quién es)
  includes        String  @default("[]") // JSON string[]  (qué recibes)
  bonuses         String  @default("[]") // JSON {title, description, unlock}[]
  faqs            String  @default("[]") // JSON {q, a}[]

  modules CourseModule[]
}

model CourseModule {
  id       String @id @default(cuid())
  title    String
  part     String? // agrupación opcional, p. ej. "Parte I · Técnica e IA"
  order    Int    @default(0)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons CourseLesson[]
}

model CourseLesson {
  id       String       @id @default(cuid())
  title    String
  duration String
  free     Boolean      @default(false)
  order    Int          @default(0)
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

// Solicitudes recibidas desde el sitio (formulario de empresas y newsletter).
// Se revisan en /admin/leads.
model Lead {
  id        String   @id @default(cuid())
  type      String // "empresa" | "newsletter"
  name      String?
  company   String?
  email     String
  teamSize  String?
  message   String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
